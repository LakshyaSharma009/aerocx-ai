# --- LLM provider (openai | anthropic | huggingface | mock) ---
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
HF_SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- RAG relevance gate (cosine similarity; calibrated on TF-IDF backend) ---
RAG_MIN_SIMILARITY=0.10

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+psycopg2://aerocx:aerocx@localhost:5432/aerocx
POSTGRES_USER=aerocx
POSTGRES_PASSWORD=aerocx
POSTGRES_DB=aerocx

# --- Model artefacts ---
MODEL_PATH=models

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- App ---
RANDOM_SEED=42
LOG_LEVEL=INFO
